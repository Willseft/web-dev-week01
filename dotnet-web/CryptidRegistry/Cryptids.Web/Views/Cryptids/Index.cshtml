@model List<Cryptid>

<h1>Cryptids Registry</h1>

<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Region</th>
            <th>Sightings</th>
            <th>Details</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var cryptid in Model)
        {
            <tr>
                <td>@cryptid.Name</td>
                <td>@cryptid.Region</td>
                <td>@cryptid.Sightings</td>
                <td>
                    <a href="/Cryptids/Details/@cryptid.Id">View Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>